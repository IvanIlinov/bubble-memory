// Bubble Memory — Prisma schema
// Сущности зафиксированы в ТЗ (раздел "Основные сущности").
// Хостинг БД — в РФ (см. ТЗ, "Безопасность и приватность").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BubbleTier {
  WOODEN // Деревянный — 0
  STONE // Каменный — 25
  BRONZE // Бронзовый — 75
  IRON // Железный — 150
  STEEL // Стальной — 300
  TITANIUM // Титановый — 500
  CRYSTAL // Кристальный — 800
  DIAMOND // Алмазный — 1200
}

// Зарезервировано на будущее (см. ТЗ: "роль преподавателя — не в MVP").
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  telegramId String @unique

  username    String?
  displayName String?

  nickname String @unique // публичный, редактируемый, отдельно от Telegram username

  bubbleTier BubbleTier @default(WOODEN)
  streak     Int        @default(0)
  totalSolved Int       @default(0)

  timezone String @default("Europe/Moscow")

  notificationsEnabled Boolean @default(true)
  notificationTime     String  @default("19:00") // "HH:mm" в timezone пользователя

  role UserRole @default(STUDENT) // зарезервировано, не используется в логике MVP

  consentGivenAt DateTime? // экран согласия — последним, перед публичным запуском

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memories       TaskMemory[]
  reviewLogs     ReviewLog[]
  weeklyBubbles  WeeklyBubble[]
  monthlyBubbles MonthlyBubble[]
  yearBubbles    YearBubble[]
}

// Лёгкий справочник заданий ЕГЭ — только для подписи бабла, без контента/ответов.
model TaskType {
  id     String @id @default(cuid())
  number Int    @unique // 1..27, конфигурируемо
  title  String

  memories   TaskMemory[]
  reviewLogs ReviewLog[]
}

model TaskMemory {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTypeId String
  taskType   TaskType @relation(fields: [taskTypeId], references: [id])

  repetitions Int @default(0)
  intervalDays Int @default(0)

  lastReview DateTime?
  nextReview DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, taskTypeId])
}

// Для undo, streak и антиспам-проверки "раз в день".
model ReviewLog {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTypeId String
  taskType   TaskType @relation(fields: [taskTypeId], references: [id])

  reviewedAt DateTime @default(now())

  previousIntervalDays Int
  previousNextReview   DateTime?

  @@index([userId, taskTypeId, reviewedAt])
}

model WeeklyBubble {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  week String // ISO-неделя, формат "GGGG-[W]WW", напр. "2026-W32"

  solvedCount Int @default(0)
  targetCount Int @default(0)

  @@unique([userId, week])
}

model MonthlyBubble {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month String // "YYYY-MM"

  solvedCount Int @default(0)

  @@unique([userId, month])
}

model YearBubble {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year Int

  solvedCount Int @default(0)

  @@unique([userId, year])
}
